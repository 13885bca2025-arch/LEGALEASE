# Google AI Studio API key
GEMINI_API_KEY=your_gemini_api_key_here

# The original project document specified Gemini 1.5 Pro.
# Google now recommends the newer Google GenAI SDK and current models.
# Example current model: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Streamlit frontend -> FastAPI backend
LEGALEASE_BACKEND_URL=http://127.0.0.1:8000
